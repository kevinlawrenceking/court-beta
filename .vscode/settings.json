{
  "github.copilot.enable": { "*": true, "plaintext": true, "markdown": true, "scminput": false },
  "anthropic.defaultModel": "claude-3.5-sonnet-latest",
  "anthropic.maxOutputTokens": 4096,
  "anthropic.temperature": 0.3,
  "anthropic.contextWindowHint": "code",
  "anthropic.autoShowResponseInChat": true,
  "anthropic.cachePrompts": true,
  "editor.inlineSuggest.enabled": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "claudeCodeChat.permissions.yoloMode": true,
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#e9dec2",
    "activityBar.background": "#e9dec2",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#3ba486",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#e9dec2",
    "statusBar.background": "#dcc99c",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#cfb476",
    "statusBarItem.remoteBackground": "#dcc99c",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#dcc99c",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#dcc99c99",
    "titleBar.inactiveForeground": "#15202b99"
  },
  "peacock.color": "#dcc99c"
}